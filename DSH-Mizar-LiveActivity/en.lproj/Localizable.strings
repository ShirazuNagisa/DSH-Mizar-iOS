/* The Live Activity: the Dynamic Island, and the card on the Lock Screen. */

/* Shown when every session has stopped. The island draws a green check for
   this; the card draws the check and these words, because a card holding only
   the app's name reads as a card that failed to load. */
"Every session has finished" = "Every session has finished";

/* What the counting clock is, for VoiceOver: on the island it is the clock
   element's whole name, and in a row of the card it is the noun at the end of
   that row's sentence. The number is drawn by the system's timer and is
   deliberately not exposed -- a ticking figure read out every second is not
   information -- so this noun is all a listener gets, and a duration announced
   with no noun is a number about nothing. */
"Running time" = "Running time";
"Elapsed time" = "Elapsed time";
"Last known elapsed" = "Last known elapsed";

/* The two buttons on a blocked turn's card, in the island and on the Lock
   Screen. "Allow once" is exactly what the protocol grants -- one call, not a
   standing permission -- and "Reject" is the other half of the choice. */
"Allow once" = "Allow once";
"Reject" = "Reject";

/* Production Live Activity overview and approval queue. */
"Approval" = "Approval";
"More sessions" = "more sessions";
"Approval waiting" = "Approval waiting";
"Sessions" = "sessions";
"Devices" = "devices";
"View overview" = "View overview";
"Running" = "Running";
"Waiting for approval" = "Waiting for approval";
"Waiting for a reply" = "Waiting for a reply";
"Offline" = "Offline";
"Untitled session" = "Untitled session";
"Longest running session" = "Longest running session";
"Longest running" = "Longest running";

/* The single focus of the approved refinement. The count appears once, in the
   trailing corner, and the pending label merges the amber signal with the
   number of requests still waiting. */
"Pending approval" = "Approval pending";
"Other sessions" = "%d more";
"Other approvals" = "%d more";
"No running sessions" = "No running sessions";
"Session count" = "Session count";
"Sending approval" = "Sending";
"Approval accepted" = "Allowed once";
"Approval rejected" = "Rejected";
"Approval failed" = "Could not send";
"Approval result unknown" = "Result unknown";
"Next" = "Next";
"Next approval" = "Next approval";
"View approval" = "View approval";
"Sending" = "Sending…";

"All approvals" = "All approvals";
