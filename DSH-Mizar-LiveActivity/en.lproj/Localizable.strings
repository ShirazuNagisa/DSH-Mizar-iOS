/* The Live Activity: the Dynamic Island, and the card on the Lock Screen. */

/* Shown when every session has stopped. The island draws a green check for
   this; the card draws the check and these words, because a card holding only
   the app's name reads as a card that failed to load. */
"Every session has finished" = "Every session has finished";

/* What the counting clock is, for VoiceOver: on the island it is the clock
   element's whole name, and in a row of the card it is the noun at the end of
   that row's sentence. The number is drawn by the system's timer and is
   deliberately not exposed -- a ticking figure read out every second is not
   information -- so this noun is all a listener gets, and a duration announced
   with no noun is a number about nothing. */
"Running time" = "Running time";

/* The two buttons on a blocked turn's card, in the island and on the Lock
   Screen. "Allow once" is exactly what the protocol grants -- one call, not a
   standing permission -- and "Reject" is the other half of the choice. */
"Allow once" = "Allow once";
"Reject" = "Reject";
