{
  "version": 1,
  "uiTestDir": "DSH-MizarUITests",
  "expectedUiTests": 133,
  "impactMap": "test/impact-map.json",
  "unitCommand": "scripts/swift.sh test",
  "forceFull": [
    "DSH-Mizar.xcodeproj/**",
    "**/*.xcscheme",
    "**/*.xctestplan",
    "MizarKit/Package.swift",
    "MizarKit/Sources/**",
    "protocol/**",
    "scripts/**",
    "test/**",
    "package.json",
    "package-lock.json",
    "DSH-Mizar/App/**",
    "DSH-Mizar/Design/**",
    "DSH-Mizar/**/*.strings",
    "DSH-Mizar/**/*.plist",
    "DSH-Mizar/**/Assets.xcassets/**",
    "DSH-Mizar/**/*.entitlements",
    "DSH-Mizar/**/*.storekit",
    "DSH-Mizar-LiveActivity/**"
  ],
  "unitOnly": [
    "MizarKit/Tests/**"
  ],
  "noTests": [
    "README.md",
    "AGENTS.md",
    "docs/**",
    "**/*.md",
    "LICENSE",
    "LICENSE-EXCEPTION",
    ".gitignore",
    ".devcache/**",
    "archive/**",
    "node_modules/**"
  ],
  "routes": [
    {
      "paths": [
        "DSH-Mizar/Views/Account/RedeemInviteView.swift"
      ],
      "select": [
        "AccountUITests"
      ],
      "note": "verified 2026-10-20: intentional copy regression in the redeem result, full suite detects it only inside AccountUITests"
    }
  ]
}
